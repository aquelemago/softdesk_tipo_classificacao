# ===========================================
# Configuracoes Minimas (Obrigatorias)
# ===========================================

# Provedor de IA para classificacao: openai, google, gemini, deepseek
CLASSIFICADOR_PROVIDER=

# Chave da API do provedor selecionado (preencha apenas a do provedor escolhido)
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# Token/hash da API Softdesk (obrigatorio para atualizar chamados)
SOFTDESK_HASH_API=

# ===========================================
# Configuracoes Opcionais
# ===========================================

# Modelo de IA (preencha apenas se quiser alterar o padrao)
# Padroes: OpenAI = gpt-4o-mini, Google = gemini-2.5-flash-lite, DeepSeek = deepseek-chat
OPENAI_MODEL=
GOOGLE_GEMINI_MODEL=
DEEPSEEK_MODEL=

# Modo de seguranca: true = nao envia atualizacoes ao Softdesk (somente teste)
# Use false para permitir atualizacoes reais
DRY_RUN=true

# Porta HTTP do servidor (padrao: 4000)
PORT=4000

# Agendamento automatico: false = desabilitado, true = habilitado
AUTO_SCHEDULE_ENABLED=false

# Limite de chamados processados por execucao (padrao: 50)
AUTO_SCHEDULE_LIMIT=50

# Base da API Softdesk (padrao: https://mainhardt.soft4.com.br/api/api.php)
SOFTDESK_API_BASE_URL=
