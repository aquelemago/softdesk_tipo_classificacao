# ===========================================
# Configuracoes Basicas (Obrigatorias)
# ===========================================

# Provedor de IA para classificacao: openai, google, gemini, deepseek
CLASSIFICADOR_PROVIDER=openai

# Chave da API do provedor selecionado
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# Token/hash da API Softdesk (obrigatorio)
SOFTDESK_HASH_API=

# ===========================================
# Configuracoes Opcionais
# ===========================================

# Modelo de IA (padrao: gpt-4o-mini para OpenAI, gemini-2.5-flash-lite para Google)
OPENAI_MODEL=gpt-4o-mini
GOOGLE_GEMINI_MODEL=gemini-2.5-flash-lite
DEEPSEEK_MODEL=deepseek-chat

# Modo de seguranca: true para nao enviar atualizacoes ao Softdesk (somente teste)
DRY_RUN=true

# Porta HTTP do servidor (padrao: 4000)
PORT=4000

# Agendamento automatico: false para desabilitar
AUTO_SCHEDULE_ENABLED=false

# Limite de chamados processados por execucao (padrao: 50)
AUTO_SCHEDULE_LIMIT=50

# Base da API Softdesk (padrao: https://mainhardt.soft4.com.br/api/api.php)
SOFTDESK_API_BASE_URL=

# ===========================================
# Configuracoes Avançadas (Gemini)
# ===========================================

# Limites de taxa para Gemini (padrao: 10 RPM, 20 RPD)
GOOGLE_GEMINI_RPM=10
GOOGLE_GEMINI_RPD=20

# Intervalo minimo entre chamadas Gemini (ms)
GOOGLE_GEMINI_MIN_INTERVAL_MS=6000

# Arquivo para controle de quota diaria do Gemini
GOOGLE_GEMINI_QUOTA_FILE=runtime/gemini-quota-usage.json

# Retries e backoff para erros transitorios (padrao: 3 retries)
GOOGLE_GEMINI_MAX_RETRIES=3
GOOGLE_GEMINI_BACKOFF_BASE_MS=2000
GOOGLE_GEMINI_BACKOFF_MAX_MS=30000
