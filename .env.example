# Variavel de ambiente esperada.
# Chave da API OpenAI usada por utils/classificador_openai.js.
OPENAI_API_KEY=

# Modelo OpenAI usado quando CLASSIFICADOR_PROVIDER=openai.
# Padrao no codigo: gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# Provider de classificacao.
# Valores reconhecidos no codigo: openai, google, gemini.
CLASSIFICADOR_PROVIDER=openai

# Chave Google Gemini usada quando CLASSIFICADOR_PROVIDER=google ou gemini.
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Modelo Gemini usado quando CLASSIFICADOR_PROVIDER=google ou gemini.
# Padrao no codigo: gemini-2.5-flash-lite.
GOOGLE_GEMINI_MODEL=gemini-2.5-flash-lite

# Protecao contra rate limit do Gemini.
# Limites da API Gemini: 10 requisicoes por minuto e 20 requisicoes por dia.
GOOGLE_GEMINI_RPM=10
GOOGLE_GEMINI_RPD=20

# Intervalo minimo entre inicios de chamadas Gemini.
# Com GOOGLE_GEMINI_RPM=10, o minimo efetivo e 6000 ms mesmo se este valor for menor.
GOOGLE_GEMINI_MIN_INTERVAL_MS=6000

# Arquivo local usado para contar requisicoes Gemini por dia.
GOOGLE_GEMINI_QUOTA_FILE=runtime/gemini-quota-usage.json

# Numero de novas tentativas para erros transitorios Gemini (429/5xx). Padrao no codigo: 3.
GOOGLE_GEMINI_MAX_RETRIES=3

# Backoff exponencial entre retries Gemini. Padroes no codigo: 2000 e 30000.
GOOGLE_GEMINI_BACKOFF_BASE_MS=2000
GOOGLE_GEMINI_BACKOFF_MAX_MS=30000

# Modo de seguranca operacional.
# Use true para montar/classificar payload sem enviar PUT ao Softdesk.
DRY_RUN=true

# Configuracao de execucao.
# Porta HTTP usada por server.js. Padrao no codigo: 4000.
PORT=4000

# Configuracao de execucao.
# Habilita ou desabilita o agendamento automatico em server.js.
# Use "false" para desabilitar. Qualquer outro valor mantem habilitado.
AUTO_SCHEDULE_ENABLED=false

# Configuracao de execucao.
# Limite de chamados processados em cada execucao automatica.
AUTO_SCHEDULE_LIMIT=50

# Token/hash da API Softdesk.
SOFTDESK_HASH_API=

# Base da API Softdesk.
SOFTDESK_API_BASE_URL=https://mainhardt.soft4.com.br/api/api.php

# Nao identificado no codigo atual:
# - Variavel para ambiente de sandbox Softdesk.
# - Variavel para desabilitar chamadas OpenAI em modo teste.
